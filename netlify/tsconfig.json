{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "functions/**/*.mts",
    "lib/**/*.mts",
    "tests/**/*.mts"
  ]
}
